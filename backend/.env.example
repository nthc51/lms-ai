DATABASE_URL=postgresql+asyncpg://lms:lms@localhost:5432/lms
DB_NULL_POOL=false
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:3000
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=lms
MINIO_SECURE=false
# Provider AI: chỉ nhận fake | gemini (giá trị khác → app/worker không khởi động).
# Provider nào là gemini thì GEMINI_API_KEY bắt buộc phải có (kiểm tra ngay lúc khởi động).
EMBED_PROVIDER=fake
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
EMBED_TIMEOUT_S=30
# Gói Gemini miễn phí giới hạn embedding 30K token/phút: đặt EMBED_BATCH_SIZE=20, EMBED_TPM_LIMIT=25000.
# EMBED_TPM_LIMIT=0 nghĩa là không giới hạn (gói trả phí).
EMBED_BATCH_SIZE=100
EMBED_TPM_LIMIT=0
VISION_PROVIDER=fake
VISION_MODEL=gemini-3.5-flash
VISION_TIMEOUT_S=120
VISION_MAX_PAGES_PER_DOC=60
VISION_CONCURRENCY=4
PENDING_JOB_REQUEUE_AFTER_MIN=10
# Khi dùng Gemini thật: EMBED_PROVIDER=gemini, VISION_PROVIDER=gemini, LLM_PROVIDER=gemini, GEMINI_API_KEY=...
# (kiểm tra lại tên model hiện hành trên trang Google AI; GEMINI_API_KEY dùng chung cho embedder/vision/LLM)
GEMINI_API_KEY=
LLM_PROVIDER=fake
LLM_MODEL=gemini-3.5-flash
LLM_CHEAP_MODEL=gemini-3.5-flash-lite
LLM_TIMEOUT_S=60
LLM_STREAM_TIMEOUT_S=120
LLM_REWRITE_TIMEOUT_S=15
LLM_CACHE_ENABLED=true
TUTOR_REFUSE_THRESHOLD=0.3
TUTOR_TOP_K=6
TUTOR_RATE_LIMIT_PER_HOUR=30
TUTOR_REWRITE_DEADLINE_S=20
TUTOR_PRESTREAM_DEADLINE_S=60
# Email. Link trong email trỏ về APP_BASE_URL (địa chỉ frontend, không có dấu / ở cuối).
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_REQUIRED=true
VERIFY_TOKEN_HOURS=24
# Dev: Mailpit trong docker compose (SMTP_HOST=mailpit khi chạy trong Docker, localhost khi chạy uvicorn ngoài),
# xem thư ở http://localhost:8025. Chạy thật với Brevo: SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
# SMTP_STARTTLS=true, SMTP_USER/SMTP_PASSWORD lấy ở Brevo › SMTP & API, MAIL_FROM là email đã xác minh trong Brevo.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_S=20
MAIL_FROM="LMS-AI <no-reply@example.com>"
MAIL_MAX_ATTEMPTS=5
